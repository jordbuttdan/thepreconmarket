# GoHighLevel integration — copy this file to `.env` and fill in real values.
# NEVER commit the real .env file. In production, set these in the Netlify
# dashboard: Site settings → Environment variables.
#
# IMPORTANT: only inbound webhook URLs and calendar embed URLs belong here.
# These are PUBLIC_ variables and are visible in the built page source.
# Never put a GHL API key or private token in a PUBLIC_ variable.

# Inbound GHL webhook that receives VIP registrations as JSON.
# In GHL: Automation → Workflows → new workflow → "Inbound Webhook" trigger →
# copy the URL. The payload shape is documented in the README.
PUBLIC_GHL_VIP_WEBHOOK_URL=

# GHL calendar embed URL for the /book page.
PUBLIC_GHL_CALENDAR_URL=

# Optional: webhook that receives the rebate checker answers + estimate.
PUBLIC_GHL_WEBHOOK_URL=

# Optional legacy: inline GHL form embed URL, if you prefer an iframe form.
PUBLIC_GHL_LEAD_FORM_URL=
