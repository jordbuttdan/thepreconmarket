# GoHighLevel embed URLs — copy this file to `.env` and fill in real values.
# NEVER commit the real .env file. In production, set these in the Netlify
# dashboard: Site settings → Environment variables.

# Inline form embed shown behind the results gate (form fields: first name,
# last name, email, phone-optional)
PUBLIC_GHL_LEAD_FORM_URL=

# Calendar embed for the /book page
PUBLIC_GHL_CALENDAR_URL=

# Optional webhook that receives the checker answers + estimate as JSON
PUBLIC_GHL_WEBHOOK_URL=
