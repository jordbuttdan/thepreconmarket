---
import Base from '../layouts/Base.astro';
import Checker from '../components/checker/Checker';
import { LAST_UPDATED } from '../lib/rebateRules';
---

<Base
  title="New Home GST/HST Rebate Checker — Ontario Pre-Construction | The Precon Market"
  description="Find out in two minutes if you qualify for up to $130,000 in new home GST/HST rebates on your Ontario pre-construction purchase. Built by a licensed broker."
>
  <div class="mx-auto max-w-[720px] px-4 pt-8 sm:px-6 sm:pt-12">
    <p class="section-label">— New Home GST/HST Rebate Checker</p>
    <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">
      Find out if you qualify for up to <span class="figure text-accent">$130,000</span> in new home tax rebates.
    </h1>
    <p class="mt-3 text-[15px] text-ink/80">
      A two-minute eligibility check for Ontario pre-construction buyers, built by a licensed broker — not a builder.
    </p>

    <div class="mt-8">
      <Checker client:load />
    </div>

    <p class="mt-3 font-mono text-xs text-ink/50">
      Rebate rules current as of {LAST_UPDATED}. Programs are time-limited and subject to change.
    </p>

    <ul class="mt-10 grid gap-4 border-t border-rule pt-6 sm:grid-cols-3">
      <li>
        <p class="section-label">— 01</p>
        <p class="mt-1 text-sm text-ink/80">Built by a licensed Ontario broker, not a builder's marketing team.</p>
      </li>
      <li>
        <p class="section-label">— 02</p>
        <p class="mt-1 text-sm text-ink/80">Ontario-specific: models the federal and provincial programs together.</p>
      </li>
      <li>
        <p class="section-label">— 03</p>
        <p class="mt-1 text-sm text-ink/80">Takes two minutes. No email needed to see your answer.</p>
      </li>
    </ul>
  </div>
</Base>
