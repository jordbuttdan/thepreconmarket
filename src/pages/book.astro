---
import Base from '../layouts/Base.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { GHL } from '../config/ghl';
import { BROKER } from '../config/site';

---

<Base
  title="Book a call about Ontario pre-construction"
  description="Book a call with Jordan Buttarazzi, Broker, Ontario pre-construction low-rise. Agreement review, rebate eligibility, builder assessment and lot selection."
  kicker={['Ontario', 'Low-rise', 'Book a call']}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Book a call', href: '/book' }]}
>
  <div class="mx-auto max-w-[1100px] px-4 pt-8 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-12">
      <div class="lg:col-span-5">
        <p class="section-label">Book a call</p>
        <h1 id="book-heading" class="mt-4 text-[1.95rem] leading-[1.1] font-semibold sm:text-[2.4rem]">
          Let's go through your situation.
        </h1>
        <p id="book-body" class="lede mt-6">
          Twenty minutes, no obligation. Bring your agreement if you have one, or your questions if
          you do not. If the honest answer is that pre-construction is wrong for you, you will hear
          that too.
        </p>

        <ul class="mt-8 space-y-3 text-[14px] leading-relaxed text-ink/75">
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-[0.6em] h-px w-3 shrink-0 bg-honey"></span>
            <span>Reading the HST rebate clause in your actual agreement</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-[0.6em] h-px w-3 shrink-0 bg-honey"></span>
            <span>Whether the development levies are capped, and what to ask for</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-[0.6em] h-px w-3 shrink-0 bg-honey"></span>
            <span>The builder's delivery record and date reliability</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-[0.6em] h-px w-3 shrink-0 bg-honey"></span>
            <span>Which lots and premiums are worth paying for</span>
          </li>
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-[0.6em] h-px w-3 shrink-0 bg-honey"></span>
            <span>Your full cash requirement, deposits, closing and fit-out</span>
          </li>
        </ul>

        <div class="tick-corners mt-8 border border-rule bg-paper-pure/70 p-4">
          <p class="section-label">Speak to</p>
          <p class="mt-2 text-sm font-medium text-ink">{BROKER.name}, {BROKER.title}</p>
          <p class="text-sm text-ink/70">{BROKER.brokerage}</p>
          <p class="figure mt-2 text-[11px] text-ink/50">RECO #{BROKER.reco}</p>
          <p class="mt-3">
            <a href={BROKER.phoneHref} class="figure text-sm text-accent underline underline-offset-2">
              {BROKER.phone}
            </a>
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        {
          GHL.calendarEmbedUrl ? (
            <iframe
              src={GHL.calendarEmbedUrl}
              title="Book a call"
              loading="lazy"
              class="h-[760px] w-full border border-rule bg-paper-pure"
            />
          ) : (
            /* Placeholder so layout can be verified before GHL codes exist. */
            <div class="flex h-[520px] flex-col items-center justify-center gap-2 border border-dashed border-caution/60 bg-accent-tint/40 p-6 text-center">
              <p class="font-mono text-sm text-label">GHL calendar embed goes here</p>
              <p class="max-w-sm text-xs text-ink/50">
                Set PUBLIC_GHL_CALENDAR_URL in .env / Netlify.
              </p>
              <a href={BROKER.phoneHref} class="btn mt-4 text-sm">Call {BROKER.phone}</a>
            </div>
          )
        }
      </div>
    </div>

    <Disclaimer />
  </div>
</Base>

<script is:inline>
  // Swap the headline to match the lead tag carried over from the rebate
  // checker results, or from an ad. Falls back silently to the default copy.
  (function () {
    var COPY = {
      'hot-cooling-off': {
        h: 'Signed in the last 10 days?',
        b: 'If a rescission right applies to your purchase it is measured in days, not weeks. Let’s read the agreement before that window closes.',
      },
      'hot-freehold-signed': {
        h: 'Signed a freehold agreement?',
        b: 'There is no cooling-off period on freehold in Ontario, so the agreement already binds you. Here is what you can still control, levies, upgrades, the rebate clause and your closing.',
      },
      'warm-shopping': {
        h: 'Let’s look at what’s actually releasing.',
        b: 'Worksheets, incentives, deposit structures and lot availability on new low-rise across the GTA, including which projects are not worth your time.',
      },
      investor: {
        h: 'Buying to rent?',
        b: 'The rebate your price assumes is not available on a rental, which changes your cash at closing by up to $80,000. Let’s model it properly before you commit.',
      },
      'likely-ineligible': {
        h: 'You may still qualify for more than you think.',
        b: 'The Ontario rebate of up to $80,000 has no first-time buyer test. Plenty of move-up buyers write themselves off for no reason.',
      },
      'needs-review': {
        h: 'Not sure what your agreement says?',
        b: 'Let’s read it together. The HST clause, the levy cap and the deposit schedule are where the money is.',
      },
    };
    try {
      var tag = new URLSearchParams(window.location.search).get('tag');
      var copy = tag && COPY[tag];
      if (!copy) return;
      var h = document.getElementById('book-heading');
      var b = document.getElementById('book-body');
      if (h) h.textContent = copy.h;
      if (b) b.textContent = copy.b;
    } catch (e) {
      /* default copy stands */
    }
  })();
</script>
