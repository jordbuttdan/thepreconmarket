---
import Base from '../layouts/Base.astro';
import { GHL } from '../config/ghl';
---

<Base
  title="Book a Call | The Precon Market"
  description="Book a call with Jordan Buttarazzi, Broker at Valery Real Estate Inc., to review your pre-construction agreement and rebate eligibility."
>
  <div class="mx-auto max-w-[720px] px-4 pt-8 sm:px-6 sm:pt-12">
    <p class="section-label">— Book a Call</p>
    <h1 id="book-headline" class="mt-3 text-3xl font-semibold sm:text-4xl">
      Not sure what your agreement says? Let's read it together.
    </h1>
    <p class="mt-3 text-[15px] text-ink/80">
      A call with Jordan Buttarazzi, Broker — no cost, no obligation. Bring your agreement if you have one.
    </p>

    <div class="card tick-corners mt-8 p-2 sm:p-4">
      {
        GHL.calendarEmbedUrl ? (
          <iframe
            src={GHL.calendarEmbedUrl}
            title="Booking calendar"
            class="h-[700px] w-full border-0"
            loading="lazy"
          />
        ) : (
          <div class="flex h-[700px] w-full flex-col items-center justify-center gap-3 border border-dashed border-rule-dark bg-paper p-6 text-center">
            <p class="font-mono text-sm text-rule-dark">GHL calendar embed goes here</p>
            <p class="max-w-sm text-xs text-ink/50">Set PUBLIC_GHL_CALENDAR_URL in .env / Netlify.</p>
            <a href="tel:+16473711367" class="mt-2 text-sm text-accent underline underline-offset-2">
              Or call (647) 371-1367
            </a>
          </div>
        )
      }
    </div>

    <p class="mt-4 text-sm text-ink/60">
      Prefer the phone? <a href="tel:+16473711367" class="text-accent underline underline-offset-2">(647) 371-1367</a>
    </p>
  </div>

  <!-- Headline varies by the lead-quality tag carried from the results page. -->
  <script>
    const HEADLINES: Record<string, string> = {
      'hot-cooling-off': "Signed in the last 10 days? Let's review your agreement before your window closes.",
      'hot-freehold-signed': "Signed a freehold agreement? There's no cooling-off period — here's what you can still control.",
      'warm-shopping': 'Get the worksheet, incentives, and deposit structure on any GTA project.',
      'needs-review': "Not sure what your agreement says? Let's read it together.",
    };
    const params = new URLSearchParams(window.location.search);
    const el = document.getElementById('book-headline');
    // A named project (from the /representation offer) beats the tag copy.
    const project = params.get('project')?.trim().slice(0, 80) ?? '';
    const tag = params.get('tag') ?? '';
    if (el && project) {
      el.textContent = `Looking at ${project}? Let's pull the worksheet, incentives, and deposit structure.`;
    } else if (el && HEADLINES[tag]) {
      el.textContent = HEADLINES[tag];
    }
  </script>
</Base>
