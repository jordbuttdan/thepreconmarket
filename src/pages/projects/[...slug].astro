---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectGate from '../../components/ProjectGate.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { GHL } from '../../config/ghl';
import { BROKER } from '../../config/site';

/**
 * Only `featured` projects get their own page. Catalogue entries are listed on
 * /projects and on their city page instead, a page per sold-out 2019 project
 * would be thin content and would drag the domain rather than help it.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection('projects');
  const faq = await getCollection('faq');
  return projects
    .filter((p) => p.data.tier === 'featured')
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry, allFaq: faq },
    }));
};

const { entry, allFaq } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const faqBySlug = new Map(allFaq.map((e) => [e.id, e]));
const relatedFaq = d.relatedFaq.map((s) => faqBySlug.get(s)).filter((e) => e != null);

const citySlug = d.city.toLowerCase().replace(/\s+/g, '-');
const fmt = (n?: number) => (n == null ? null : '$' + n.toLocaleString('en-CA'));
const priceLabel =
  d.priceFrom != null
    ? d.priceTo != null
      ? `${fmt(d.priceFrom)} – ${fmt(d.priceTo)}`
      : `From ${fmt(d.priceFrom)}`
    : 'TBA';

const specs: { k: string; v: string }[] = [
  { k: 'Builder', v: d.builder.join(', ') },
  { k: 'Location', v: d.intersection ?? `${d.neighbourhood ?? ''} ${d.city}`.trim() },
  { k: 'City', v: d.city },
  { k: 'Ownership', v: d.ownership },
  { k: 'Home types', v: d.homeTypes.join(', ') },
  { k: 'Status', v: d.salesStatus },
  ...(d.launchDate ? [{ k: 'Launch', v: d.launchDate }] : []),
  { k: 'Price', v: priceLabel },
  ...(d.sizeFrom
    ? [{ k: 'Size', v: `${d.sizeFrom.toLocaleString('en-CA')} – ${d.sizeTo?.toLocaleString('en-CA')} sq ft` }]
    : []),
  ...(d.lotWidths.length ? [{ k: 'Lot widths', v: d.lotWidths.join(', ') + ' ft' }] : []),
  ...(d.floorPlanCount ? [{ k: 'Floor plans', v: String(d.floorPlanCount) }] : []),
  ...(d.bedBreakdown ? [{ k: 'Bedrooms', v: d.bedBreakdown }] : []),
  ...(d.occupancy ? [{ k: 'Occupancy', v: d.occupancy }] : []),
];
---

<Base
  title={`${d.name}, ${d.city} ${d.homeTypes.includes('detached') ? 'detached homes' : 'townhomes'}`}
  description={d.description ?? d.shortAnswer}
  updated={d.updated}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Projects', href: '/projects' },
    { name: d.name, href: `/projects/${entry.id}` },
  ]}
  article={{
    headline: `${d.name}, ${d.city}`,
    description: d.shortAnswer,
    dateModified: d.updated,
  }}
  faq={d.projectFaq.length ? d.projectFaq.map((f) => ({ question: f.q, answer: f.a })) : undefined}
  place={{
    name: d.name,
    city: d.city,
    intersection: d.intersection,
    lat: d.lat,
    lng: d.lng,
    priceFrom: d.priceFrom,
    priceTo: d.priceTo,
  }}
>
  <div class="mx-auto max-w-[1100px] px-4 pt-6 sm:px-6">
    {
      d.heroImage && (
        <figure class="tick-corners border border-rule">
          <Image
            src={d.heroImage}
            alt={d.heroAlt ?? `${d.name} in ${d.city}`}
            widths={[760, 1120, 2000]}
            sizes="(min-width: 1100px) 1068px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        </figure>
      )
    }

    <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-x-12">
      <article class="lg:col-span-8">
        <p class="section-label">{d.neighbourhood ? `${d.neighbourhood}, ` : ''}{d.city}</p>
        <h1 class="mt-3 text-[2rem] font-semibold sm:text-[2.5rem]">{d.name}</h1>
        <p class="mt-2 text-[15px] text-ink/65">{d.builder.join(' · ')}</p>

        <p class="lede mt-6">{d.shortAnswer}</p>

        {
          d.highlights.length > 0 && (
            <ul class="mt-8 grid gap-x-8 gap-y-1 sm:grid-cols-2">
              {d.highlights.map((h) => (
                <li class="flex items-baseline gap-2 border-b border-rule/60 py-2 text-[14px] text-ink/80">
                  <span aria-hidden="true" class="mt-[0.45em] h-px w-2.5 shrink-0 bg-honey" />
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )
        }

        <div class="prose-precon mt-10">
          <Content />
        </div>

        {
          (d.depositStructure.length > 0 || d.incentives.length > 0) && (
            <section class="mt-12 grid gap-4 sm:grid-cols-2">
              {d.depositStructure.length > 0 && (
                <div class="card p-5">
                  <p class="section-label">Deposit structure</p>
                  <ul class="mt-3 space-y-1.5 text-[13px] text-ink/80">
                    {d.depositStructure.map((x) => (
                      <li class="flex items-baseline gap-2">
                        <span aria-hidden="true" class="mt-[0.45em] h-px w-2.5 shrink-0 bg-honey" />
                        <span class="figure">{x}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-3 text-[12px] leading-relaxed text-ink/55">
                    Set by the builder and subject to change. Tarion protects a freehold deposit
                    up to $100,000.{' '}
                    <a href="/faq/is-my-deposit-protected-freehold-ontario" class="text-accent underline underline-offset-2">How that works</a>
                  </p>
                </div>
              )}
              {d.incentives.length > 0 && (
                <div class="card p-5">
                  <p class="section-label">Current incentives</p>
                  <ul class="mt-3 space-y-1.5 text-[13px] text-ink/80">
                    {d.incentives.map((x) => (
                      <li class="flex items-baseline gap-2">
                        <span aria-hidden="true" class="mt-[0.45em] h-px w-2.5 shrink-0 bg-honey" />
                        <span>{x}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="mt-3 text-[12px] leading-relaxed text-ink/55">
                    Incentives are withdrawn and changed without notice, and must be written into an
                    amendment to be binding.
                  </p>
                </div>
              )}
            </section>
          )
        }

        {/* Deliverables, not body copy. See the note in ProjectGate.astro. */}
        <ProjectGate
          name={d.name}
          builders={d.builder}
          salesStatus={d.salesStatus}
          slug={entry.id}
          citySlug={citySlug}
          webhookUrl={GHL.vipWebhookUrl}
          priceFrom={d.priceFrom}
          sizeFrom={d.sizeFrom}
          sizeTo={d.sizeTo}
          floorPlanCount={d.floorPlanCount}
          lotWidths={d.lotWidths}
          hasDeposit={d.depositStructure.length > 0}
        />

        {
          d.projectFaq.length > 0 && (
            /* Rendered as plain text, not an accordion: content hidden behind
               JS interaction is weaker for both crawlers and AI assistants. */
            <section class="mt-12">
              <div class="flex items-baseline gap-3 border-b border-rule-dark pb-2">
                <h2 class="text-lg font-semibold">{d.name}, common questions</h2>
                <span class="figure text-[11px] text-ink/45">{d.projectFaq.length}</span>
              </div>
              <dl class="mt-5 space-y-5">
                {d.projectFaq.map((f) => (
                  <div class="border-l-2 border-honey pl-4">
                    <dt class="text-[15px] font-semibold text-ink">{f.q}</dt>
                    <dd class="mt-1.5 text-[14px] leading-relaxed text-ink/80">{f.a}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }

        {
          d.gallery.length > 0 && (
            <section class="mt-12">
              <p class="section-label">Renderings</p>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {d.gallery.map((g) => (
                  <figure class="border border-rule">
                    <Image
                      src={g.src}
                      alt={g.alt}
                      widths={[420, 840, 1200]}
                      sizes="(min-width: 640px) 50vw, 100vw"
                      loading="lazy"
                      class="block h-auto w-full"
                    />
                  </figure>
                ))}
              </div>
              <p class="mt-2 font-mono text-[11px] text-ink/45">
                Renderings are the builder's and are subject to change. Not a representation.
              </p>
            </section>
          )
        }

        <Disclaimer />
      </article>

      <aside class="lg:col-span-4">
        <div class="sticky top-6 space-y-8">
          <!-- Spec table, set like a drawing title block. -->
          <div class="card p-5">
            <p class="section-label">Project data</p>
            <dl class="mt-3 divide-y divide-rule/70 text-[13px]">
              {
                specs.map((s) => (
                  <div class="flex gap-3 py-2">
                    <dt class="w-28 shrink-0 text-ink/55">{s.k}</dt>
                    <dd class="text-ink/90">{s.v}</dd>
                  </div>
                ))
              }
            </dl>
            {
              d.lat != null && d.lng != null && (
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${d.lat}%2C${d.lng}`}
                  rel="nofollow noopener"
                  target="_blank"
                  class="mt-3 inline-block text-[13px] text-accent underline underline-offset-2"
                >
                  View on map →
                </a>
              )
            }
          </div>

          <!-- One form per page: the registration block in the article. -->
          <a href="#register" class="btn w-full text-sm">
            {d.priceFrom != null ? 'Get floor plans & pricing' : 'Get notified at launch'}
          </a>

          {
            relatedFaq.length > 0 && (
              <div>
                <p class="section-label">Before you sign</p>
                <ul class="mt-3">
                  {relatedFaq.map((r) => (
                    <li class="border-b border-rule/60">
                      <a
                        href={`/faq/${r.id}`}
                        class="flex items-baseline gap-2 py-2.5 text-[13px] leading-snug text-ink/80 hover:text-accent"
                      >
                        <span aria-hidden="true" class="mt-[0.45em] h-px w-2.5 shrink-0 bg-honey" />
                        <span>{r.data.question}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          <div class="border border-rule p-4">
            <p class="section-label">Talk it through</p>
            <p class="mt-2 text-[13px] leading-relaxed text-ink/75">
              Lot selection, builder comparison and the agreement, before you commit.
            </p>
            <a href="/book" class="btn mt-3 w-full text-[13px]">Book a call</a>
            <p class="mt-3 text-center">
              <a href={BROKER.phoneHref} class="figure text-[13px] text-accent underline underline-offset-2">
                {BROKER.phone}
              </a>
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>
