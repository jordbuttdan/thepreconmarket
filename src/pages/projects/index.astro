---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Cta from '../../components/Cta.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { ON_ENHR } from '../../lib/rebateRules';

const all = await getCollection('projects');
const featured = all
  .filter((p) => p.data.tier === 'featured')
  .sort((a, b) => a.data.order - b.data.order);
const cityNames = [...new Set(featured.map((p) => p.data.city))].sort();

const latest = all.length
  ? new Date(all.map((p) => p.data.updated.getTime()).reduce((a, b) => Math.max(a, b), 0))
  : undefined;
---

<Base
  title="New low-rise projects in Ontario, detached, towns & semis"
  description="Hand-picked new freehold low-rise communities across the GTA and surrounding Ontario markets: detached homes, townhomes and semis. Current and upcoming launches, filterable by city, home type and budget."
  updated={latest}
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Projects', href: '/projects' }]}
>
  <div class="mx-auto max-w-[1100px] px-4 pt-8 sm:px-6">
    <p class="section-label">Projects</p>
    <h1 class="mt-4 max-w-[26ch] text-[2rem] font-semibold sm:text-[2.6rem]">
      New freehold low-rise, current and upcoming
    </h1>
    <p class="lede mt-6 max-w-[62ch]">
      Freehold detached homes, townhomes and semis across Ontario, recently launched and
      upcoming. Filter by city, home type and budget.
    </p>

    <div class="mt-6 border border-rule bg-accent-tint/50 p-4">
      <p class="text-[14px] leading-relaxed text-ink/80">
        <span class="section-label">Why timing matters</span>
        <span class="mt-2 block">
          The Ontario Enhanced New Housing Rebate of up to <span class="figure">$80,000</span>
          {' '}requires an agreement signed before <span class="figure">{ON_ENHR.WINDOW_CLOSES}</span>,
          and it has no first-time buyer test. It runs on the signing date, not the closing date,
          so which phase you buy into matters as much as which community.
          {' '}<a href="/hst-rebate" class="text-accent underline underline-offset-2">How the rebates work</a>.
        </span>
      </p>
    </div>

    <section class="mt-12">
      <form
        id="project-filters"
        class="grid gap-3 border-y border-rule-dark py-4 sm:grid-cols-4"
        onsubmit="return false"
      >
        <label class="block text-[12px] font-medium text-ink/70">
          City
          <select name="city" class="mt-1 block min-h-11 w-full border border-rule bg-paper-pure px-2 text-[14px]">
            <option value="">All cities</option>
            {cityNames.map((c) => <option value={c}>{c}</option>)}
          </select>
        </label>
        <label class="block text-[12px] font-medium text-ink/70">
          Home type
          <select name="type" class="mt-1 block min-h-11 w-full border border-rule bg-paper-pure px-2 text-[14px]">
            <option value="">Any type</option>
            <option value="detached">Detached</option>
            <option value="semi">Semi-detached</option>
            <option value="townhome">Townhome</option>
          </select>
        </label>
        <label class="block text-[12px] font-medium text-ink/70">
          Starting under
          <select name="max" class="mt-1 block min-h-11 w-full border border-rule bg-paper-pure px-2 text-[14px]">
            <option value="">Any price</option>
            <option value="700000">$700,000</option>
            <option value="850000">$850,000</option>
            <option value="1000000">$1,000,000</option>
            <option value="1250000">$1,250,000</option>
            <option value="1500000">$1,500,000</option>
          </select>
        </label>
        <p class="self-end pb-2.5 text-[13px] text-ink/70">
          <span id="project-count" class="figure font-medium text-ink">{featured.length}</span> communities
          <button type="reset" class="ml-3 text-accent underline underline-offset-2">Clear</button>
        </p>
      </form>

      <ul id="project-grid" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => (
          <li
            class="flex"
            data-city={p.data.city}
            data-types={p.data.homeTypes.join(' ')}
            data-price={p.data.priceFrom ?? ''}
          >
            <ProjectCard project={p} />
          </li>
        ))}
      </ul>
      <p id="project-empty" hidden class="mt-6 border border-dashed border-rule p-6 text-[14px] text-ink/70">
        Nothing listed matches that yet.
        <a href="/vip" class="text-accent underline underline-offset-2">Tell me what you are looking for</a>
        and I will send you what comes up.
      </p>
    </section>

    <Cta
      variant="vip"
      heading="Looking for something not listed here?"
      body="Tell me the city, home type and budget and I'll send you what is releasing that fits."
    />
    <Disclaimer />
  </div>
</Base>

<script>
  const form = document.getElementById('project-filters') as HTMLFormElement | null;
  const items = [...document.querySelectorAll<HTMLElement>('#project-grid > li')];
  const count = document.getElementById('project-count');
  const empty = document.getElementById('project-empty');
  function apply() {
    if (!form) return;
    const f = new FormData(form);
    const city = String(f.get('city') ?? '');
    const type = String(f.get('type') ?? '');
    const max = Number(f.get('max') ?? 0);
    let shown = 0;
    for (const li of items) {
      const price = Number(li.dataset.price || 0);
      const ok =
        (!city || li.dataset.city === city) &&
        (!type || (li.dataset.types ?? '').split(' ').includes(type)) &&
        (!max || (price > 0 && price <= max));
      li.hidden = !ok;
      if (ok) shown++;
    }
    if (count) count.textContent = String(shown);
    if (empty) empty.hidden = shown > 0;
    const q = new URLSearchParams();
    if (city) q.set('city', city);
    if (type) q.set('type', type);
    if (max) q.set('max', String(max));
    history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
  }
  if (form) {
    // Filters live in the URL so a filtered view can be shared or linked to.
    const q = new URLSearchParams(location.search);
    for (const k of ['city', 'type', 'max']) {
      const el = form.elements.namedItem(k) as HTMLSelectElement | null;
      if (el && q.get(k)) el.value = q.get(k)!;
    }
    form.addEventListener('change', apply);
    form.addEventListener('reset', () => setTimeout(apply));
    apply();
  }
</script>
