---
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { GHL } from '../config/ghl';
---

<Base
  title="Register for VIP access to Ontario low-rise releases"
  description="Register for builder price lists, floor plans and deposit structures on new freehold detached, townhome and semi releases across the GTA, with guidance from a broker who represents you."
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'VIP access', href: '/vip' }]}
>
  <div class="mx-auto max-w-[1100px] px-4 pt-8 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-12">
      <div class="lg:col-span-5">
        <p class="section-label">VIP access</p>
        <h1 class="mt-4 text-[1.95rem] leading-[1.1] font-semibold sm:text-[2.4rem]">
          New low-rise releases, sent to you as they open.
        </h1>
        <p class="lede mt-6">
          Builders release new communities in phases. Register and I will send you price lists,
          floor plans and deposit structures for freehold detached homes, townhomes and semis
          across the GTA as they become available, and help you make sense of them.
        </p>

        <div class="mt-8 space-y-5">
          {
            [
              {
                n: '01',
                h: 'Release details',
                b: 'Price lists, floor plans and deposit structures for the releases that match your home type, budget and area.',
              },
              {
                n: '02',
                h: 'Help choosing a lot',
                b: 'On low-rise the lot is the decision you cannot revisit. We go through width, orientation, grading and what sits behind it before you choose.',
              },
              {
                n: '03',
                h: 'Honest assessment',
                b: 'Including when a release is not worth your time. You will hear about the builder’s delivery record and date reliability, not just the renderings.',
              },
              {
                n: '04',
                h: 'Guidance to the keys',
                b: 'Agreement review with your lawyer, deposit dates, the décor appointment, the pre-delivery inspection and possession.',
              },
            ].map((item) => (
              <div class="flex gap-4">
                <p class="section-label shrink-0 pt-1">{item.n}</p>
                <div>
                  <h2 class="text-[15px] font-semibold">{item.h}</h2>
                  <p class="mt-1 text-[14px] leading-relaxed text-ink/70">{item.b}</p>
                </div>
              </div>
            ))
          }
        </div>

      </div>

      <div class="lg:col-span-7">
        <div class="card p-5 sm:p-7">
          <p class="section-label">Register</p>
          <h2 class="mt-2 text-xl font-semibold">Tell me what you're looking for</h2>
          <p class="mt-2 text-[14px] leading-relaxed text-ink/70">
            Name, email and phone. That is all it takes to get started.
          </p>
          <div class="mt-6">
            <LeadForm webhookUrl={GHL.vipWebhookUrl} />
          </div>
        </div>

        <div class="mt-6 border border-rule bg-accent-tint/40 p-5">
          <p class="section-label">One important note</p>
          <p class="mt-2 text-[14px] leading-relaxed text-ink/75">
            Most builders require your broker to be registered <strong class="font-semibold">at or
            before your first visit</strong> for representation to be recognised. If you visit a
            sales centre unrepresented, you often cannot add representation afterward. Register
            before you go.
          </p>
          <a
            href="/faq/do-i-need-a-realtor-pre-construction"
            class="mt-3 inline-block text-[13px] text-accent underline underline-offset-2"
          >
            Why this matters →
          </a>
        </div>
      </div>
    </div>

    <Disclaimer />
  </div>
</Base>
