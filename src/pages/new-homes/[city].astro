---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import VipForm from '../../components/VipForm';
import Cta from '../../components/Cta.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { GHL } from '../../config/ghl';

export const getStaticPaths: GetStaticPaths = async () => {
  const cities = await getCollection('cities');
  const projects = await getCollection('projects');
  const faq = await getCollection('faq');
  return cities.map((entry) => ({
    params: { city: entry.id },
    props: {
      entry,
      // Projects are matched on the city field so a new project page appears
      // on its city page automatically, with no cross-referencing to maintain.
      projects: projects.filter(
        (p) => p.data.city.toLowerCase() === entry.data.city.toLowerCase(),
      ),
      allFaq: faq,
      siblings: cities.filter(
        (c) => c.data.region === entry.data.region && c.id !== entry.id,
      ),
    },
  }));
};

const { entry, projects, allFaq, siblings } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const faqBySlug = new Map(allFaq.map((e) => [e.id, e]));
const relatedFaq = d.relatedFaq.map((s) => faqBySlug.get(s)).filter((e) => e != null);

const featured = projects.filter((p) => p.data.tier === 'featured');
const catalogue = projects.filter((p) => p.data.tier === 'catalogue');
const fmt = (n?: number) => (n == null ? null : '$' + n.toLocaleString('en-CA'));
---

<Base
  title={`New homes in ${d.city} — detached, towns & semis`}
  description={d.description ?? d.shortAnswer}
  kicker={[d.region, 'Low-rise', d.priceFrom ? `${fmt(d.priceFrom)}+` : 'No active supply']}
  updated={d.updated}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'New homes', href: '/new-homes' },
    { name: d.city, href: `/new-homes/${entry.id}` },
  ]}
  article={{
    headline: `New freehold low-rise homes in ${d.city}`,
    description: d.shortAnswer,
    dateModified: d.updated,
  }}
>
  <div class="mx-auto max-w-[1100px] px-4 pt-6 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-12">
      <article class="lg:col-span-8">
        <p class="section-label">— {d.region}</p>
        <h1 class="mt-3 text-[2rem] font-semibold sm:text-[2.5rem]">
          New homes in {d.city}
        </h1>
        <p class="mt-2 text-[15px] text-ink/60">
          Freehold detached, townhomes and semis — no condos
        </p>

        <p class="lede mt-6">{d.shortAnswer}</p>

        {
          featured.length > 0 && (
            <section class="mt-10">
              <div class="flex items-baseline gap-3 border-b border-rule-dark pb-2">
                <h2 class="text-lg font-semibold">Featured in {d.city}</h2>
                <span class="figure text-[11px] text-ink/45">{featured.length}</span>
              </div>
              <ul class="mt-5 grid gap-5 sm:grid-cols-2">
                {featured.map((p) => (
                  <li class="contents">
                    <ProjectCard project={p} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="prose-precon mt-10">
          <Content />
        </div>

        {
          catalogue.length > 0 && (
            <section class="mt-12">
              <p class="section-label">— Earlier {d.city} projects</p>
              <div class="mt-3">
                {catalogue.map((p) => (
                  <ProjectCard project={p} compact />
                ))}
              </div>
            </section>
          )
        }

        <Cta
          variant="vip"
          heading={`Looking in ${d.city}?`}
          body="Most low-rise releases are allocated before the sales centre opens publicly. Tell me the home type and budget and I'll send what's actually coming."
        />
        <Disclaimer />
      </article>

      <aside class="lg:col-span-4">
        <div class="sticky top-6 space-y-8">
          <div class="card p-5">
            <p class="section-label">— {d.city} at a glance</p>
            <dl class="mt-3 divide-y divide-rule/70 text-[13px]">
              <div class="flex gap-3 py-2">
                <dt class="w-24 shrink-0 text-ink/55">Region</dt>
                <dd class="text-ink/90">{d.region}</dd>
              </div>
              {
                d.priceFrom && (
                  <div class="flex gap-3 py-2">
                    <dt class="w-24 shrink-0 text-ink/55">Price range</dt>
                    <dd class="figure text-ink/90">
                      {fmt(d.priceFrom)} – {fmt(d.priceTo)}
                    </dd>
                  </div>
                )
              }
              <div class="flex gap-3 py-2">
                <dt class="w-24 shrink-0 text-ink/55">Projects</dt>
                <dd class="text-ink/90">
                  {projects.length > 0 ? `${projects.length} tracked` : 'None active'}
                </dd>
              </div>
              {
                d.communities.length > 0 && (
                  <div class="flex gap-3 py-2">
                    <dt class="w-24 shrink-0 text-ink/55">Communities</dt>
                    <dd class="text-ink/90">{d.communities.join(', ')}</dd>
                  </div>
                )
              }
            </dl>
          </div>

          <div class="tick-corners border border-rule bg-accent-tint/50 p-5">
            <p class="section-label">— Register</p>
            <h2 class="mt-2 text-[17px] font-semibold">{d.city} releases</h2>
            <p class="mt-2 text-[13px] leading-relaxed text-ink/75">
              Opening price lists, lot availability and deposit structures, before public opening.
            </p>
            <div class="mt-4">
              <VipForm webhookUrl={GHL.vipWebhookUrl} city={entry.id} compact client:visible />
            </div>
          </div>

          {
            relatedFaq.length > 0 && (
              <div>
                <p class="section-label">— Before you sign</p>
                <ul class="mt-3">
                  {relatedFaq.map((r) => (
                    <li class="border-b border-rule/60">
                      <a
                        href={`/faq/${r.id}`}
                        class="flex items-baseline gap-2 py-2.5 text-[13px] leading-snug text-ink/80 hover:text-accent"
                      >
                        <span aria-hidden="true" class="mt-[0.45em] h-px w-2.5 shrink-0 bg-honey" />
                        <span>{r.data.question}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {
            siblings.length > 0 && (
              <div>
                <p class="section-label">— Nearby in {d.region}</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {siblings.map((s) => (
                    <li>
                      <a
                        href={`/new-homes/${s.id}`}
                        class="inline-block border border-rule bg-paper-pure px-2.5 py-1 text-[12px] text-ink/80 hover:border-honey hover:bg-accent-tint"
                      >
                        {s.data.city}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </aside>
    </div>
  </div>
</Base>
