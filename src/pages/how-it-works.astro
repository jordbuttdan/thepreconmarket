---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { BROKER } from '../config/site';

const STEPS = [
  {
    n: '01',
    h: 'You register',
    b: 'Takes a minute. You tell me home type, budget and area.',
  },
  {
    n: '02',
    h: 'You get access',
    b: 'Every active and upcoming low-rise release, with the builder price lists, floor plans, deposit structures and lot availability. Not a filtered list. All of it.',
  },
  {
    n: '03',
    h: 'We shortlist',
    b: 'I tell you which ones are worth your time, which builders hit their dates, and which lots are worth the premium.',
  },
  {
    n: '04',
    h: 'We do the paperwork',
    b: 'I secure your lot on release day. Your lawyer reviews the agreement before you sign. I push for the amendments that matter, starting with a cap on development levies.',
  },
  {
    n: '05',
    h: 'I stay on it through the build',
    b: 'Deposit dates, Tarion registration, your décor appointment, and the closing date when it moves. Which it will.',
  },
  {
    n: '06',
    h: 'PDI and possession',
    b: 'I walk the pre-delivery inspection with you so nothing gets missed, then see you through to keys.',
  },
];

const faqSchema = [
  {
    question: 'How does buying pre-construction with a broker work?',
    answer:
      'You register with a broker, who gives you access to builder price lists, floor plans and deposit structures across active and upcoming releases. The broker shortlists projects, secures your lot on release day, coordinates the agreement review with your lawyer, tracks deposits and dates through the build, and attends the pre-delivery inspection before possession.',
  },
  {
    question: 'What does a pre-construction broker cost the buyer?',
    answer:
      'Nothing. The builder budgets a co-operating brokerage commission into the price whether or not you bring representation. If you buy unrepresented the builder keeps that amount and the price does not drop.',
  },
];
---

<Base
  title="How it works"
  description="Register once and get access to every active and upcoming low-rise release in the GTA: builder price lists, floor plans and deposit structures. Then representation from first enquiry through paperwork, PDI and possession, at no cost to you."
  kicker={['Ontario', 'Low-rise', 'The service']}
  width="narrow"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'How it works', href: '/how-it-works' }]}
  faq={faqSchema}
>
  <div class="mx-auto max-w-[820px] px-4 pt-10 sm:px-6">
    <p class="section-label">The service</p>
    <h1 class="mt-4 text-[2.1rem] leading-[1.1] font-semibold sm:text-[2.8rem]">
      Register once. See everything.
    </h1>
    <p class="lede mt-7">
      The moment you register, you get the builder price lists, floor plans, deposit structures and
      lot availability for every active and upcoming low-rise release in the GTA. Then I take you
      from that first enquiry through to the keys.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/vip" class="btn text-sm">Register for access</a>
      <a href="/book" class="btn-secondary text-sm">Book a call</a>
    </div>

    <!-- The journey, stated as plainly as possible. -->
    <ol class="mt-16 space-y-0">
      {
        STEPS.map((s, i) => (
          <li
            class:list={[
              'grid gap-x-8 gap-y-2 border-t border-rule py-6 sm:grid-cols-12',
              i === STEPS.length - 1 && 'border-b',
            ]}
          >
            <div class="sm:col-span-4">
              <p class="section-label">{s.n}</p>
              <h2 class="mt-1.5 text-[18px] font-semibold">{s.h}</h2>
            </div>
            <p class="text-[15px] leading-relaxed text-ink/75 sm:col-span-8">{s.b}</p>
          </li>
        ))
      }
    </ol>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">What it costs you</h2>
      <p class="mt-4 text-[16px] leading-[1.75] text-ink/85">
        Nothing. Builders budget a co-operating commission into the price whether or not you bring
        a broker. Walk in alone and they keep it. The price does not drop.
      </p>
      <p class="mt-4 text-[16px] leading-[1.75] text-ink/85">
        One catch worth knowing: most builders require your broker to be registered at or before
        your first sales centre visit. Visit unrepresented and you usually cannot add it
        afterwards. So register before you go.
      </p>
    </section>

    <section class="mt-14 border border-rule bg-accent-tint/50 p-6 sm:p-7">
      <h2 class="text-xl font-semibold">Why timing matters right now</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink/80">
        Up to $80,000 of Ontario HST relief, with no first-time buyer test, applies to agreements
        signed before 31 March 2027. It runs on the signing date, not the closing date, and you
        cannot sign for a lot in a phase that has not been released yet.
      </p>
      <a href="/hst-rebate" class="mt-4 inline-block text-[13px] text-accent underline underline-offset-2">
        How the rebates work
      </a>
    </section>

    <section class="mt-14 border-t border-rule pt-8">
      <h2 class="text-xl font-semibold">Who you are working with</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink/80">
        {BROKER.name}, {BROKER.title} at {BROKER.brokerage}, RECO #{BROKER.reco}. Freehold low-rise
        only, across the GTA. If pre-construction is the wrong move for you right now, you will
        hear that too.
      </p>
      <a href="/about" class="mt-3 inline-block text-[13px] text-accent underline underline-offset-2">
        More about Jordan
      </a>
    </section>

    <Cta variant="vip" heading="Ready to see what's releasing?" body="Register and I'll send the current price lists and what's coming next." />
  </div>
</Base>
