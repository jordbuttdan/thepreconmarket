---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

const STEPS = [
  {
    n: '01',
    h: 'Register',
    b: 'Home type, budget and area. Takes a minute.',
  },
  {
    n: '02',
    h: 'Get the details',
    b: 'Price lists, floor plans and deposits for matching releases, as they open.',
  },
  {
    n: '03',
    h: 'Shortlist',
    b: 'Compare projects, builders and the real cost after the fine print.',
  },
  {
    n: '04',
    h: 'Sign with confidence',
    b: 'Lot selection, a lawyer review, and the amendments that matter, starting with a levy cap.',
  },
  {
    n: '05',
    h: 'Through the build',
    b: 'Deposit dates, Tarion, décor and closing-date changes, all tracked.',
  },
  {
    n: '06',
    h: 'PDI and keys',
    b: 'A walk-through of the pre-delivery inspection, then possession.',
  },
];

const faqSchema = [
  {
    question: 'How does buying pre-construction with a broker work?',
    answer:
      'You register with a broker, who shares builder price lists, floor plans and deposit structures for releases that fit what you are looking for. The broker helps you compare projects, guides you through lot selection and the agreement alongside your lawyer, tracks deposits and dates through the build, and attends the pre-delivery inspection before possession.',
  },
  {
    question: 'When should I register with a broker for a pre-construction purchase?',
    answer:
      'Before your first sales centre visit. Most builders require a buyer\'s broker to be registered at or before the first visit for representation to be recognised, and it usually cannot be added afterwards.',
  },
];
---

<Base
  title="How it works"
  description="Register once for builder price lists, floor plans and deposit structures on new low-rise releases across the GTA, then guidance from first enquiry through paperwork, PDI and possession."
  width="narrow"
  breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'How it works', href: '/how-it-works' }]}
  faq={faqSchema}
>
  <div class="mx-auto max-w-[820px] px-4 pt-10 sm:px-6">
    <p class="section-label">The service</p>
    <h1 class="mt-4 text-[2.1rem] leading-[1.1] font-semibold sm:text-[2.8rem]">
      Register once. Get guided the whole way.
    </h1>
    <p class="lede mt-7">
      Price lists, floor plans and deposits for releases that fit your search, then guidance
      through to the keys.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/vip" class="btn text-sm">Register for access</a>
      <a href="/book" class="btn-secondary text-sm">Book a call</a>
    </div>

    <!-- The journey, stated as plainly as possible. -->
    <ol class="mt-16 space-y-0">
      {
        STEPS.map((s, i) => (
          <li
            class:list={[
              'grid gap-x-8 gap-y-2 border-t border-rule py-6 sm:grid-cols-12',
              i === STEPS.length - 1 && 'border-b',
            ]}
          >
            <div class="sm:col-span-4">
              <p class="section-label">{s.n}</p>
              <h2 class="mt-1.5 text-[18px] font-semibold">{s.h}</h2>
            </div>
            <p class="text-[15px] leading-relaxed text-ink/75 sm:col-span-8">{s.b}</p>
          </li>
        ))
      }
    </ol>

    <section class="mt-16">
      <h2 class="text-2xl font-semibold">One thing to do first</h2>
      <p class="mt-4 text-[16px] leading-[1.75] text-ink/85">
        Register before you visit a sales centre. Most builders won't recognise a broker added
        afterward.
      </p>
    </section>

    <section class="mt-14 border border-rule bg-accent-tint/50 p-6 sm:p-7">
      <h2 class="text-xl font-semibold">Why timing matters right now</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink/80">
        Up to $80,000 in Ontario HST relief, no first-time buyer test, for agreements signed by
        March 31, 2027. The signing date counts, not closing.
      </p>
      <a href="/hst-rebate" class="mt-4 inline-block text-[13px] text-accent underline underline-offset-2">
        How the rebates work
      </a>
    </section>

    <Cta variant="vip" heading="Ready to see what's releasing?" body="Get current price lists and what's coming next." center />
  </div>
</Base>
