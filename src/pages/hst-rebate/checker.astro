---
import Base from '../../layouts/Base.astro';
import Checker from '../../components/checker/Checker';
import Disclaimer from '../../components/Disclaimer.astro';
import { LAST_UPDATED } from '../../lib/rebateRules';
import { BROKER } from '../../config/site';

const updated = new Date(LAST_UPDATED);
---

<Base
  title="New home HST rebate checker — Ontario"
  description="Estimate your Ontario and federal new home HST and GST rebates in about two minutes. Covers the Enhanced New Housing Rebate, the first-time buyer GST rebate and the Ontario 5% top-up."
  kicker={['Ontario', 'Eligibility check', `Rev ${LAST_UPDATED}`]}
  updated={updated}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'HST rebate', href: '/hst-rebate' },
    { name: 'Checker', href: '/hst-rebate/checker' },
  ]}
>
  <div class="mx-auto max-w-[1100px] px-4 sm:px-6">
    <div class="grid gap-8 pt-8 lg:grid-cols-12 lg:gap-x-12 lg:gap-y-8">
      <!-- DOM order is the mobile order: headline, then the tool, so the
           checker is never pushed below the fold on a phone. -->
      <div class="lg:col-span-5 lg:col-start-1 lg:row-start-1">
        <p class="section-label">— Eligibility check</p>
        <h1 class="mt-4 text-[1.95rem] leading-[1.1] font-semibold sm:text-[2.4rem]">
          Find out if you qualify for up to{' '}
          <span class="figure whitespace-nowrap text-honey">$130,000</span>{' '}
          in new home tax rebates.
        </h1>
        <p class="mt-4 max-w-[46ch] text-[15px] leading-relaxed text-ink/75">
          Two new rebate programs took effect this year. Most buyers are working from last year's
          numbers, and on a typical GTA low-rise purchase the difference runs into six figures.
        </p>
        <p class="mt-4 max-w-[46ch] text-[14px] leading-relaxed text-ink/65">
          About two minutes. No email required to see your estimate.
        </p>
      </div>

      <div class="lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
        <Checker client:load />
        <p class="mt-3 font-mono text-[11px] leading-relaxed text-ink/45">
          Rebate rules current as of {LAST_UPDATED}. Programs are time-limited and subject to change.
        </p>
      </div>

      <!-- Credential block, set like a drawing stamp. -->
      <div class="lg:col-span-5 lg:col-start-1 lg:row-start-2 lg:self-start">
        <div class="tick-corners border border-rule bg-paper-pure/70 p-4">
          <p class="section-label">— Prepared by</p>
          <p class="mt-2 text-sm font-medium text-ink">{BROKER.name}, {BROKER.title}</p>
          <p class="text-sm text-ink/70">{BROKER.brokerage}</p>
          <p class="figure mt-2 text-[11px] text-ink/50">
            RECO #{BROKER.reco} · {BROKER.phone}
          </p>
        </div>
        <Disclaimer variant="compact" />
      </div>
    </div>

    <section class="mt-16 border-t border-rule pt-8">
      <p class="section-label">— Before you rely on a number</p>
      <p class="mt-3 max-w-[68ch] text-[15px] leading-relaxed text-ink/80">
        This gives you the band you are in. What it cannot tell you is whether the clause in your
        agreement protects you, whether your signing date falls inside the Ontario window, or
        whether the spousal test applies to your household. Those are the three things that decide
        whether you actually keep the money.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/book" class="btn text-sm">Have your agreement reviewed</a>
        <a href="/hst-rebate" class="btn-secondary text-sm">How the programs work</a>
      </div>
    </section>
  </div>
</Base>
