---
import { Image } from 'astro:assets';
import logo from '../assets/logo-longform.png';
// Latin subsets only. The full packages ship 25 files across scripts this site never uses.
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { SITE, BROKER, NAV } from '../config/site';
import Schema from '../components/seo/Schema.astro';
import StickyMobileCta from '../components/StickyMobileCta.astro';

interface Breadcrumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Breadcrumb[];
  /** Visible + schema dateModified. Freshness is a citation signal. */
  updated?: Date;
  isHome?: boolean;
  /** Passed straight through to the Schema component. */
  faq?: { question: string; answer: string }[];
  article?: {
    headline: string;
    description: string;
    datePublished?: Date;
    dateModified: Date;
  };
  place?: {
    name: string;
    city: string;
    intersection?: string;
    lat?: number;
    lng?: number;
    priceFrom?: number;
    priceTo?: number;
  };
  /** Set true on thin utility pages that should not be indexed. */
  noindex?: boolean;
  /**
   * Content measure. 'narrow' is for single-column reading pages; the date
   * and breadcrumb strips match it so nothing sits out of alignment.
   */
  width?: 'wide' | 'narrow';
}

const {
  title,
  description,
  breadcrumbs,
  updated,
  isHome,
  faq,
  article,
  place,
  noindex,
  width = 'wide',
} = Astro.props;

const measure = width === 'narrow' ? 'max-w-[820px]' : 'max-w-[1100px]';

const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');

// Dates are authored as plain YYYY-MM-DD, which parses as UTC midnight.
// Formatting in local time would render them a day early west of Greenwich.
const dateFmt = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {
      !noindex && (
        <meta
          name="robots"
          content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
        />
      )
    }

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:image" content={`${SITE.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE.url}/og.png`} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="author" content={`${BROKER.name}, ${BROKER.title}`} />
    <meta name="geo.region" content="CA-ON" />
    {updated && <meta name="last-modified" content={updated.toISOString()} />}

    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <Schema
      pageTitle={fullTitle}
      pageDescription={description}
      faq={faq}
      article={article}
      place={place}
      breadcrumbs={breadcrumbs}
      isHome={isHome}
    />

    <!-- ANALYTICS PLACEHOLDER: GA4 -->
    <!-- Paste the GA4 gtag.js snippet here. Do not hardcode the measurement
         ID anywhere else in the codebase. -->
    <!-- END ANALYTICS PLACEHOLDER: GA4 -->

    <!-- ANALYTICS PLACEHOLDER: Meta Pixel -->
    <!-- Paste the Meta Pixel base code here. -->
    <!-- END ANALYTICS PLACEHOLDER: Meta Pixel -->
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-paper-pure focus:px-4 focus:py-2 focus:text-sm"
    >
      Skip to content
    </a>

    <header class="border-b border-rule bg-paper/95 backdrop-blur">
      <div class="mx-auto flex max-w-[1100px] items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <a href="/" class="shrink-0" aria-label={`${SITE.name}, home`}>
          {/* Served at up to 3x its display height so it stays crisp on dense screens. */}
          <Image
            src={logo}
            alt={SITE.name}
            height={144}
            densities={[1, 2]}
            loading="eager"
            class="block h-9 w-auto sm:h-12"
          />
        </a>

        <nav aria-label="Main" class="flex items-center gap-4 sm:gap-6">
          <ul class="hidden items-center gap-5 text-sm lg:flex">
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'py-1 transition-colors hover:text-accent',
                      isActive(item.href)
                        ? 'border-b border-honey font-medium text-ink'
                        : 'text-ink/75',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/book" class="btn px-4 text-sm">Book a call</a>
        </nav>
      </div>

      <!-- Mobile nav: a horizontally scrollable rail, no hamburger to tap. -->
      <div class="border-t border-rule lg:hidden">
        <ul
          class="mx-auto flex max-w-[1100px] gap-4 overflow-x-auto px-4 py-2 text-[13px] sm:px-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        >
          {
            NAV.map((item) => (
              <li class="shrink-0">
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'inline-block py-1 whitespace-nowrap',
                    isActive(item.href)
                      ? 'border-b border-honey font-medium text-ink'
                      : 'text-ink/70',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    {
      updated && (
        <div class="border-b border-rule bg-paper-pure/60">
          <div
            class:list={[
              'mx-auto px-4 py-2 font-mono text-[11px] tracking-[0.08em] text-label uppercase sm:px-6',
              measure,
            ]}
          >
            Updated <time datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>
          </div>
        </div>
      )
    }

    {
      breadcrumbs?.length && (
        <nav aria-label="Breadcrumb" class:list={['mx-auto px-4 pt-4 sm:px-6', measure]}>
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[12px] text-ink/55">
            {breadcrumbs.map((b, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && (
                  <span aria-hidden="true" class="text-label">
                    /
                  </span>
                )}
                {i === breadcrumbs.length - 1 ? (
                  <span class="text-ink/75">{b.name}</span>
                ) : (
                  <a href={b.href} class="hover:text-accent hover:underline">
                    {b.name}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="main">
      <slot />
    </main>

    <StickyMobileCta />

    <!-- pb-24 on mobile keeps the sticky CTA from covering footer content. -->
    <footer class="mt-20 border-t border-rule-dark bg-paper-pure pb-24 lg:pb-0">
      <div class="mx-auto max-w-[1100px] px-4 pt-12 pb-8 sm:px-6">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-x-12">
          <!-- Brand block: the logo, one line on what the site is, and the two
               ways to reach a person. -->
          <div class="lg:col-span-5">
            <a href="/" class="inline-block" aria-label={`${SITE.name}, home`}>
              <Image
                src={logo}
                alt={SITE.name}
                height={168}
                densities={[1, 2]}
                loading="lazy"
                class="block h-11 w-auto sm:h-14"
              />
            </a>
            <p class="mt-4 max-w-[38ch] text-[15px] leading-relaxed text-ink/75">
              New construction across the GTA, with a broker who represents your interests, not
              the builder's.
            </p>
            {/* No button here: the header and the mobile bar already carry
                "Book a call" on every page. Just the direct lines. */}
            <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2">
              <a
                href={BROKER.phoneHref}
                class="figure text-[15px] font-medium text-ink hover:text-accent"
              >
                {BROKER.phone}
              </a>
              <a
                href={`mailto:${BROKER.email}`}
                class="text-sm text-accent underline underline-offset-2"
              >
                Email Jordan
              </a>
            </div>
          </div>

          <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
            <div>
              <p class="section-label">Browse</p>
              <ul class="mt-3 space-y-2 text-sm text-ink/75">
                <li><a href="/projects" class="hover:text-accent">All projects</a></li>
                <li><a href="/launching" class="hover:text-accent">Launching now</a></li>
                <li><a href="/new-homes" class="hover:text-accent">Browse by city</a></li>
                <li><a href="/vip" class="hover:text-accent">Register for VIP access</a></li>
                <li><a href="/how-it-works" class="hover:text-accent">How it works</a></li>
              </ul>
            </div>
            <div>
              <p class="section-label">Learn</p>
              <ul class="mt-3 space-y-2 text-sm text-ink/75">
                <li><a href="/hst-rebate" class="hover:text-accent">HST &amp; GST rebates</a></li>
                <li><a href="/hst-rebate/checker" class="hover:text-accent">Rebate checker</a></li>
                <li><a href="/guides" class="hover:text-accent">Buyer guides</a></li>
                <li><a href="/resources" class="hover:text-accent">Free checklists</a></li>
                <li><a href="/faq" class="hover:text-accent">Questions &amp; answers</a></li>
              </ul>
            </div>
            <div>
              <p class="section-label">Company</p>
              <ul class="mt-3 space-y-2 text-sm text-ink/75">
                <li><a href="/about" class="hover:text-accent">About</a></li>
                <li><a href="/disclaimer" class="hover:text-accent">Disclaimer</a></li>
                <li><a href="/privacy" class="hover:text-accent">Privacy policy</a></li>
                <li><a href="/sitemap-index.xml" class="hover:text-accent">Sitemap</a></li>
              </ul>
            </div>
          </nav>
        </div>

        <!-- Compliance, stated once, as fine print. RECO: the brokerage name is
             at least as prominent as the individual's, so it comes first and
             the two are set at the same size. -->
        <p class="mt-10 border-t border-rule pt-6 text-xs leading-relaxed text-ink/55">
          {BROKER.brokerage}. {BROKER.name}, {BROKER.title}. RECO #{BROKER.reco}. This site
          provides general information about published program rules, not tax, legal or
          accounting advice. Rebate eligibility is determined by the Canada Revenue Agency.
          Confirm your situation with your own lawyer and accountant before relying on any
          figure. Not intended to solicit buyers or sellers currently under contract with another
          brokerage. Read the{' '}
          <a href="/disclaimer" class="text-accent underline underline-offset-2">full disclaimer</a>.
        </p>

        <p class="mt-4 text-xs text-ink/50">
          © {year} {SITE.name}
        </p>
      </div>
    </footer>
  </body>
</html>
