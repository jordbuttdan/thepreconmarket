---
/**
 * Citation list. Every page making a claim about tax or contract rules names
 * its sources. This is an accuracy discipline first, if a claim has no
 * source, it should not be on the page, and a trust signal second.
 */
interface Props {
  sources: { label: string; url: string }[];
}
const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="mt-10 border-t border-rule pt-5">
      <p class="section-label">Sources</p>
      <ul class="mt-3 space-y-1.5 text-[13px]">
        {sources.map((s) => (
          <li>
            <a
              href={s.url}
              rel="nofollow noopener"
              target="_blank"
              class="text-accent underline underline-offset-2 hover:text-ink"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
