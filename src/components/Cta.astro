---
/**
 * The standard end-of-content call to action. Every terminal state on the
 * site offers a next step. That was true of the original checker build and
 * it stays true here.
 */
import { BROKER } from '../config/site';

interface Props {
  heading?: string;
  body?: string;
  /** Context passed to the VIP form so GHL can tag the lead by source page. */
  variant?: 'call' | 'vip';
  /** Centre the heading, copy and buttons. */
  center?: boolean;
}

const {
  heading = 'Buying new low-rise in Ontario?',
  body = 'Straight answers on the project, the builder and the agreement, from a broker who represents you rather than the builder.',
  variant = 'call',
  center = false,
} = Astro.props;
---

<aside class:list={['tick-corners mt-12 border border-rule bg-paper-pure p-5 sm:p-7', center && 'text-center']}>
  <p class="section-label">Next step</p>
  <h2 class="mt-3 text-xl font-semibold">{heading}</h2>
  <p class:list={['mt-2 max-w-[56ch] text-[15px] leading-relaxed text-ink/75', center && 'mx-auto']}>{body}</p>
  <div class:list={['mt-5 flex flex-wrap items-center gap-3', center && 'justify-center']}>
    {
      variant === 'vip' ? (
        <>
          <a href="/vip" class="btn text-sm">
            Register for VIP access
          </a>
          <a href="/book" class="btn-secondary text-sm">
            Book a call
          </a>
        </>
      ) : (
        <>
          <a href="/book" class="btn text-sm">
            Book a call
          </a>
          <a href="/vip" class="btn-secondary text-sm">
            Register for VIP access
          </a>
        </>
      )
    }
    <a href={BROKER.phoneHref} class="figure text-sm text-accent underline underline-offset-2">
      {BROKER.phone}
    </a>
  </div>
</aside>
