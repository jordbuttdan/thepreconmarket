---
// Rebate relief plotted against purchase price, drawn as a dimensioned
// section. Scale: $0 at x=60, $2,000,000 at x=960.
const x = (dollars: number) => 60 + (dollars / 2_000_000) * 900;

const M1 = x(1_000_000);
const M15 = x(1_500_000);
const M185 = x(1_850_000);
const END = x(2_000_000);
---

<figure class="mt-8">
  <div class="overflow-x-auto border border-rule bg-paper-pure">
    <svg
      viewBox="0 0 1000 232"
      role="img"
      aria-labelledby="bands-title bands-desc"
      class="block h-auto w-full min-w-[680px]"
    >
      <title id="bands-title">Rebate relief by purchase price</title>
      <desc id="bands-desc">
        The federal first-time buyers' rebate pays the full 5% GST up to $1,000,000, tapers to nil by $1,500,000, and
        pays nothing above that. The Ontario enhanced rebate pays the full 8% provincial HST up to $1,000,000, holds
        flat at $80,000 to $1,500,000, tapers to $1,850,000, and drops to the standard $24,000 above that.
      </desc>

      <defs>
        <pattern id="hatch" width="6" height="6" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#E8E0CE" stroke-width="1"></line>
        </pattern>
      </defs>

      <!-- Extension lines dropped from each price threshold. -->
      {
        [M1, M15, M185].map((px) => (
          <line x1={px} y1="28" x2={px} y2="196" stroke="#B5A479" stroke-width="1" stroke-dasharray="2 3" />
        ))
      }

      <!-- ROW 1 — FEDERAL -->
      <text x="60" y="22" font-family="monospace" font-size="10" letter-spacing="1.2" fill="#B5A479">
        FEDERAL — FIRST-TIME BUYERS ONLY
      </text>
      <rect x="60" y="30" width={M1 - 60} height="30" fill="#FDF3DC" stroke="#8A6A1F" stroke-width="1"></rect>
      <text x={(60 + M1) / 2} y="49" text-anchor="middle" font-family="monospace" font-size="11" fill="#8A6A1F">
        FULL 5% GST · UP TO $50,000
      </text>
      <rect x={M1} y="30" width={M15 - M1} height="30" fill="#FFFDF7" stroke="#B5A479" stroke-width="1"></rect>
      <text x={(M1 + M15) / 2} y="49" text-anchor="middle" font-family="monospace" font-size="10" fill="#9A4A18">
        TAPERS TO NIL
      </text>
      <rect x={M15} y="30" width={END - M15} height="30" fill="url(#hatch)" stroke="#B5A479" stroke-width="1"></rect>
      <text x={(M15 + END) / 2} y="49" text-anchor="middle" font-family="monospace" font-size="10" fill="#B5A479">
        NIL
      </text>

      <!-- ROW 2 — ONTARIO -->
      <text x="60" y="94" font-family="monospace" font-size="10" letter-spacing="1.2" fill="#B5A479">
        ONTARIO — NOT RESTRICTED TO FIRST-TIME BUYERS
      </text>
      <rect x="60" y="102" width={M1 - 60} height="30" fill="#FDF3DC" stroke="#8A6A1F" stroke-width="1"></rect>
      <text x={(60 + M1) / 2} y="121" text-anchor="middle" font-family="monospace" font-size="11" fill="#8A6A1F">
        FULL 8% HST · UP TO $80,000
      </text>
      <rect x={M1} y="102" width={M15 - M1} height="30" fill="#FDF3DC" stroke="#8A6A1F" stroke-width="1"></rect>
      <text x={(M1 + M15) / 2} y="121" text-anchor="middle" font-family="monospace" font-size="10" fill="#8A6A1F">
        FLAT $80,000
      </text>
      <rect x={M15} y="102" width={M185 - M15} height="30" fill="#FFFDF7" stroke="#B5A479" stroke-width="1"></rect>
      <text x={(M15 + M185) / 2} y="121" text-anchor="middle" font-family="monospace" font-size="10" fill="#9A4A18">
        TAPERS
      </text>
      <rect x={M185} y="102" width={END - M185} height="30" fill="url(#hatch)" stroke="#B5A479" stroke-width="1"></rect>
      <text x={(M185 + END) / 2} y="121" text-anchor="middle" font-family="monospace" font-size="9" fill="#14161A">
        $24,000
      </text>

      <!-- DIMENSION STRING -->
      <line x1="60" y1="170" x2={END} y2="170" stroke="#14161A" stroke-width="1"></line>
      {
        [60, M1, M15, M185, END].map((px) => (
          <line x1={px - 4} y1="166" x2={px + 4} y2="174" stroke="#14161A" stroke-width="1" />
        ))
      }
      <text x="60" y="190" text-anchor="middle" font-family="monospace" font-size="10" fill="#14161A">$0</text>
      <text x={M1} y="190" text-anchor="middle" font-family="monospace" font-size="10" fill="#14161A">$1.0M</text>
      <text x={M15} y="190" text-anchor="middle" font-family="monospace" font-size="10" fill="#14161A">$1.5M</text>
      <text x={M185} y="190" text-anchor="middle" font-family="monospace" font-size="10" fill="#14161A">$1.85M</text>
      <text x={END} y="190" text-anchor="middle" font-family="monospace" font-size="10" fill="#14161A">$2.0M</text>
      <text x="510" y="216" text-anchor="middle" font-family="monospace" font-size="10" letter-spacing="1.2" fill="#B5A479">
        PURCHASE PRICE BEFORE TAX
      </text>
    </svg>
  </div>
  <figcaption class="mt-2 font-mono text-[11px] text-ink/45">
    Fig. 01 — Relief by price band. Ontario figures per CRA Notice 346.
  </figcaption>
</figure>
